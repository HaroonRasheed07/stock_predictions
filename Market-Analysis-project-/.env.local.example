# Backend API base URL (Render deployment)
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=https://stock-predictions-b6yx.onrender.com

# SEO / canonical origin (must match the production domain)
NEXT_PUBLIC_SITE_URL=https://stockvantex.com

# 'true' in production so robots/sitemap allow indexing
SEO_INDEXING_ENABLED=true

# Google Analytics 4 measurement ID (public identifier, not a secret).
# The app falls back to this ID if the variable is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-87F1WZ9KPF
